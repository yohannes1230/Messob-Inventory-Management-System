# AM-PMS API — environment template
# Copy to .env and fill in real values. NEVER commit the real .env file.

NODE_ENV=development
PORT=4000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/am_pms_dev?replicaSet=rs0

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Auth (Section 9 of design doc) ---
JWT_ACCESS_SECRET=change-me-access-secret-minimum-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# --- Password Policy & Lockout ---
PASSWORD_MIN_LENGTH=8
PASSWORD_COMPLEXITY_REGEX=^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[!@#$%^&*]).{8,}$
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
MFA_ISSUER=AM-PMS
TOKEN_CLEANUP_GRACE_DAYS=30

# --- Object storage (MinIO / S3-compatible) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=am-pms-dev

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_GATEWAY_API_KEY=

# --- CORS ---
WEB_APP_ORIGIN=http://localhost:5173
