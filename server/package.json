{
  "name": "@am-pms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AM-PMS backend — Node.js + Express + TypeScript. See docs/AM-PMS_System_Design_Document_v1.0.md Section 4/6/7/8 for the full spec this implements.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js --runInBand"
  },
  "dependencies": {
    "@am-pms/shared-constants": "*",
    "@am-pms/shared-types": "*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "otplib": "^12.0.1",
    "pino": "^9.3.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.2.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
